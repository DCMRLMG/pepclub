# Copy to .env.local for local dev, and add these in the Vercel dashboard for production.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY   # server-side only, keep secret

# Business details (shown on the invoice)
BUSINESS_NAME=Your Business
BUSINESS_VENMO=@your-business

# Public base URL for invoice links (set after first deploy)
PUBLIC_BASE_URL=https://your-app.vercel.app

# Admin page (shared password for /admin.html)
ADMIN_PASSWORD=choose-a-strong-password
